# Server runtime (Northflank / Docker / Node.js)
PORT=3000
NODE_ENV=production
# Optional: mount a Northflank Persistent Volume (e.g. /data) and point DATA_DIR to it
# DATA_DIR=/data

# =============================================================================
# AI Architecture Secrets (NEW)
# =============================================================================

# Free Plan: Qwen 3.8 via Groq (text, tools, attachments, under-the-hood reference image analysis, voice transcription)
GROQ_API_KEY=""

# Paid (Pro) Plan: DeepSeek (< V4.0) for text & tools
DEEPSEEK_API_KEY=""

# Paid (Pro) Plan: ApiMira (GPT Image 2 for image generation/editing + DeepSeek < V4.0 fallback)
APIMIRA_API_KEY=""
APIMIRA_BASE_URL="https://apimira.com/v1"

# Optional: Pollinations API key for Free plan & Pro hourly-limit image generation
POLLINATIONS_API_KEY=""

# =============================================================================
# Non-AI Infrastructure & Payments (UNCHANGED)
# =============================================================================

# Required: HMAC signing secret for Pro subscription proofs (set a persistent 32+ char random secret in production)
SUBSCRIPTION_SIGNING_SECRET=""
# Optional: comma-separated extra SHA-256 hex hashes of additional one-time Pro license keys
# EXTRA_PRO_KEY_HASHES=""

# Optional: GitHub OAuth integration in Flow (/api/auth/github/*)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: Override Firebase config (otherwise firebase-applet-config.json is used)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID="(default)"
# FIREBASE_PROJECT_ID=""
# FIREBASE_DATABASE_ID="(default)"

# Optional: PostgreSQL for Library metadata with enforced Row Level Security (RLS)
# POSTGRES_URL="postgresql://user:password@host:5432/igseek?sslmode=require"
# POSTGRES_SSL="true"

# Optional: S3-compatible object storage for presigned Library uploads/downloads (Yandex Object Storage / Cloudflare R2 / Selectel / AWS S3 / MinIO)
# S3_ENDPOINT="https://storage.yandexcloud.net"
# S3_REGION="ru-central1"
# S3_BUCKET="igseek-library"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="true"

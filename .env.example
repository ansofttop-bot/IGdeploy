# Server runtime (Northflank / Docker / Node.js)
PORT=3000
NODE_ENV=production
# Optional: mount a Northflank Persistent Volume (e.g. /data) and point DATA_DIR to it
# DATA_DIR=/data

# Required for AI chat & reasoning
DEEPSEEK_API_KEY=""

# Required for DeepSeek gateway fallback & GPT Image 2 generation/editing
APIMIRA_API_KEY=""
APIMIRA_BASE_URL="https://apimira.com/v1"

# Required for server-side voice transcription fallback (/api/transcribe)
GEMINI_API_KEY=""
# Optional: override transcription model (defaults to gemini-3.5-transcribe with fallback to gemini-2.5-flash)
GEMINI_TRANSCRIBE_MODEL=""

# Required for Free tier (Mistral AI Free API: text, attachments, vision, tool calling across Chat/Engine/Flow)
MISTRAL_API_KEY=""
# Optional: override Mistral model (defaults to mistral-small-latest / ministral-8b-latest / pixtral-12b-2409)
MISTRAL_MODEL=""
# Optional: Pollinations API key (removes the 1-request/45s IP rate limit on Pollinations fallback)
POLLINATIONS_API_KEY=""

# Required for Pro subscription payments via Platega (149 RUB/month)
PLATEGA_MERCHANT_ID=""
PLATEGA_SECRET_KEY=""
# Optional: dedicated HMAC signing secret for Pro subscription proofs (falls back to PLATEGA_SECRET_KEY)
SUBSCRIPTION_SIGNING_SECRET=""

# Optional: GitHub OAuth integration in Flow (/api/auth/github/*)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: Override Firebase config (otherwise firebase-applet-config.json is used)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID="(default)"
# FIREBASE_PROJECT_ID=""
# FIREBASE_DATABASE_ID="(default)"
